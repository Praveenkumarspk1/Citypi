# AI Smart City Concierge - Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# Application Settings
# ==========================================
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
APP_NAME="Smart City Concierge"
APP_VERSION=0.1.0

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"

# ==========================================
# Database (PostgreSQL + PostGIS)
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=concierge
DATABASE_PASSWORD=concierge_dev_password
DATABASE_NAME=concierge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_DECODE_RESPONSES=true

# ==========================================
# ChromaDB (Vector Database)
# ==========================================
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_SSL=false
CHROMADB_AUTH_TOKEN=

# ==========================================
# MinIO (S3-compatible Object Storage)
# ==========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=concierge-media
MINIO_SECURE=false
MINIO_REGION=us-east-1

# ==========================================
# AI/ML Models
# ==========================================
# Gemini API (Required - Get from https://aistudio.google.com/)
AI_GEMINI_API_KEY=your_gemini_api_key_here
AI_GEMINI_MODEL=gemini-1.5-flash
AI_GEMINI_TEMPERATURE=0.7
AI_GEMINI_MAX_TOKENS=2048
AI_GEMINI_TOP_P=0.95
AI_GEMINI_TOP_K=40

# Embeddings (BGE-M3 - runs locally)
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_BATCH_SIZE=32
AI_EMBEDDING_DEVICE=cpu
AI_EMBEDDING_NORMALIZE=true

# Whisper STT (runs locally)
AI_WHISPER_MODEL=small
AI_WHISPER_DEVICE=cpu
AI_WHISPER_COMPUTE_TYPE=int8

# CLIP Vision (runs locally)
AI_CLIP_MODEL=openai/clip-vit-base-patch32
AI_CLIP_DEVICE=cpu

# Reranker (runs locally)
AI_RERANKER_MODEL=BAAI/bge-reranker-base
AI_RERANKER_DEVICE=cpu

# Recommendation (LightFM)
AI_LIGHTFM_COMPONENTS=64
AI_LIGHTFM_LEARNING_RATE=0.05
AI_LIGHTFM_EPOCHS=30
AI_LIGHTFM_LOSS=warp

# ==========================================
# Authentication
# ==========================================
AUTH_JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_API_KEY_HEADER=X-API-Key
AUTH_API_KEY_PREFIX=sk_
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_DIGITS=true
AUTH_PASSWORD_REQUIRE_SPECIAL=false
AUTH_TOKEN_REFRESH_THRESHOLD=300
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=900

# ==========================================
# Rate Limiting
# ==========================================
RATELIMIT_AUTH_LIMIT=10
RATELIMIT_AUTH_WINDOW=60
RATELIMIT_API_LIMIT=1000
RATELIMIT_API_WINDOW=60
RATELIMIT_WEBSOCKET_LIMIT=50
RATELIMIT_WEBSOCKET_WINDOW=60

# ==========================================
# Observability
# ==========================================
OBS_LOG_LEVEL=INFO
OBS_LOG_FORMAT=json
OBS_LOG_FILE=
OBS_METRICS_ENABLED=true
OBS_METRICS_PORT=9090
OBS_METRICS_PATH=/metrics
OBS_TRACING_ENABLED=true
OBS_JAEGER_ENDPOINT=http://localhost:14268/api/traces
OBS_SERVICE_NAME=concierge-api
OBS_SAMPLE_RATE=0.1
OBS_HEALTH_CHECK_INTERVAL=30

# ==========================================
# External APIs
# ==========================================
# OpenStreetMap / Overpass
EXTERNAL_OVERPASS_URL=https://overpass-api.de/api/interpreter
EXTERNAL_OVERPASS_RATE_LIMIT=60
EXTERNAL_NOMINATIM_URL=https://nominatim.openstreetmap.org
EXTERNAL_NOMINATIM_RATE_LIMIT=1

# Open-Meteo Weather
EXTERNAL_OPEN_METEO_URL=https://api.open-meteo.com/v1
EXTERNAL_OPEN_METEO_RATE_LIMIT=100

# GTFS Transit (mobilitydatabase.org - migrated from transitfeeds.com)
EXTERNAL_GTFS_STATIC_URL=https://api.mobilitydatabase.org/v1/gtfs_feeds
EXTERNAL_GTFS_REALTIME_URL=https://api.mobilitydatabase.org/v1/gtfs_rt_feeds
EXTERNAL_GTFS_API_KEY=your_mobilitydatabase_api_key_here
EXTERNAL_GTFS_RATE_LIMIT=10

# OpenChargeMap (EV Charging - Get key from https://openchargemap.org/)
EXTERNAL_OPENCHARGEMAP_URL=https://api.openchargemap.io/v3
EXTERNAL_OPENCHARGEMAP_API_KEY=your_openchargemap_key_here
EXTERNAL_OPENCHARGEMAP_RATE_LIMIT=100

# Socrata Open Data
EXTERNAL_SOCRATA_DOMAIN=
EXTERNAL_SOCRATA_APP_TOKEN=
EXTERNAL_SOCRATA_RATE_LIMIT=100

# ==========================================
# Frontend (Vite)
# ==========================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8001

# ==========================================
# Grafana
# ==========================================
GRAFANA_PASSWORD=admin