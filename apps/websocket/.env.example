# WebSocket Service Environment Variables
# Copy to .env and customize

# App
APP_NAME=AI Smart City Concierge
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# JWT Auth
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=smart-city-concierge
JWT_AUDIENCE=smart-city-concierge-users
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_CONNECTION_TIMEOUT=300
WS_MAX_MESSAGE_SIZE=1048576
WS_MAX_CONNECTIONS_PER_USER=5

# Connection Manager
CM_CLEANUP_INTERVAL=60
CM_STALE_CONNECTION_TIMEOUT=300

# Handlers
CHAT_MAX_HISTORY=100
LOCATION_BROADCAST_RADIUS=1000.0
LOCATION_UPDATE_THROTTLE=5
TRANSIT_ALERT_COOLDOWN=60
NOTIFICATION_TTL=86400

# Observability
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=websocket-service
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_COLLECTOR_ENDPOINT=http://jaeger:14268/api/traces
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics