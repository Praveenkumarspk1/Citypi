# Local Environment Overrides
# Copy this file to .env.local and customize for your machine
# This file is NOT committed to git

# Development settings
DEBUG=true
LOG_LEVEL=DEBUG

# Database (local overrides)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=local_password
DATABASE_NAME=concierge_dev

# Redis (local overrides)
REDIS_HOST=localhost
REDIS_PORT=6379

# ChromaDB (local overrides)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8001/ws

# Feature flags
ENABLE_DEBUG_TOOLS=true
ENABLE_MOCK_APIS=false
